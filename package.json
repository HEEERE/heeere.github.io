{
  "name": "jzy-agent-memory-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p remotion/tsconfig.json --noEmit",
    "build": "npm run models:validate && npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "models:generate": "node scripts/generate-models.mjs",
    "models:validate": "node scripts/validate-models.mjs",
    "remotion:studio": "remotion studio remotion/src/index.ts --config=remotion/remotion.config.ts --no-open",
    "render:intro": "remotion render remotion/src/index.ts CinematicIntro public/video/intro-fallback.mp4 --config=remotion/remotion.config.ts --codec=h264",
    "render:teaser": "remotion render remotion/src/index.ts PortfolioTeaser public/video/portfolio-teaser.mp4 --config=remotion/remotion.config.ts --codec=h264",
    "render:vertical": "remotion render remotion/src/index.ts VerticalTeaser public/video/portfolio-teaser-vertical.mp4 --config=remotion/remotion.config.ts --codec=h264"
  },
  "dependencies": {
    "@remotion/media": "^4.0.0",
    "@remotion/three": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "@react-three/fiber": "^9.0.0",
    "gsap": "^3.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@remotion/cli": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
