{
  "name": "jzy-hakoniwa-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p remotion/tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "posters": "node scripts/posters.mjs",
    "qa": "node scripts/e2e.mjs",
    "shots": "node scripts/shots.mjs",
    "og": "node scripts/og.mjs",
    "vault:shots": "node scripts/vault-shots.mjs",
    "vault:icons": "node scripts/vault-icons.mjs",
    "remotion:studio": "remotion studio remotion/src/index.ts --config=remotion/remotion.config.ts --no-open",
    "render:intro": "remotion render remotion/src/index.ts CinematicIntro remotion/out/intro.mp4 --config=remotion/remotion.config.ts --codec=h264",
    "render:teaser": "remotion render remotion/src/index.ts PortfolioTeaser remotion/out/teaser.mp4 --config=remotion/remotion.config.ts --codec=h264",
    "render:vertical": "remotion render remotion/src/index.ts VerticalTeaser remotion/out/teaser-vertical.mp4 --config=remotion/remotion.config.ts --codec=h264"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.0.0",
    "@remotion/media": "^4.0.0",
    "@remotion/three": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0",
    "three": "^0.180.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@remotion/cli": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "eslint": "^9.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
